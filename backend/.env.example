# Local PostgreSQL + PostGIS. Copy to .env; never commit real credentials.
NODE_ENV=development
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=pithole_dev
# For cloud PostgreSQL use DB_URL instead of DB_HOST/DB_*.
# DB_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DB_URL must not contain sslmode/ssl/etc. Certificate verification is mandatory.
# DB_SSL_CA=PEM certificate from your database provider, if required
FRONTEND_ORIGINS=http://localhost:5173
# Set independent random secrets, each at least 32 characters.
ADMIN_SESSION_SECRET=
DEVICE_API_KEY=
# Development only; leave false for normal testing of device authentication.
ALLOW_UNAUTHENTICATED_DEVICES=false
# Set only after verifying the number of trusted reverse proxies.
# TRUST_PROXY_HOPS=1
